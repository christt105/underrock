{
	"name": "underrock",
	"version": "0.0.0",
	"description": "Export Obsidian notes to well-typeset PDFs with a live paginated preview.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"pdf",
		"export"
	],
	"author": "christt105",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"happy-dom": "^21.0.4",
		"obsidian": "^1.14.4",
		"playwright": "^1.63.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"pagedjs": "^0.4.3"
	}
}
